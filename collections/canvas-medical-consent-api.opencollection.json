      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{canvas-instance}.canvasmedical.com/auth/token/",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Consent",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Consents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://fumage-{canvas-instance}.canvasmedical.com/Consent",
            "params": [
              {
                "name": "patient",
                "value": "",
                "type": "query",
                "description": "Filter by patient ID or reference"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by resource status"
              },
              {
                "name": "_count",
                "value": "",
                "type": "query",
                "description": "Maximum number of results per page"
              },
              {
                "name": "_page_token",
                "value": "",
                "type": "query",
                "description": "Pagination token for next page"
              }
            ]
          },
          "docs": "Search Consents"
        },
        {
          "info": {
            "name": "Create Consent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://fumage-{canvas-instance}.canvasmedical.com/Consent",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Consent"
        },
        {
          "info": {
            "name": "Read Consent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://fumage-{canvas-instance}.canvasmedical.com/Consent/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Logical ID of the FHIR resource"
              }
            ]
          },
          "docs": "Read Consent"
        }
      ]
    }
  ],
  "bundled": true
}