{
  "opencollection": "1.0.0",
  "info": {
    "name": "Canvas Medical FHIR AllergyIntolerance Metadata API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{canvas-instance}.canvasmedical.com/auth/token/",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get server capability statement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://fumage-{canvas-instance}.canvasmedical.com/metadata"
          },
          "docs": "Returns the FHIR CapabilityStatement for the Canvas Medical FHIR server"
        }
      ]
    }
  ],
  "bundled": true
}